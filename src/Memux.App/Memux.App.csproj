<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memux.Core\Memux.Core.csproj" />
    <ProjectReference Include="..\Memux.Skills\Memux.Skills.csproj" />
    <ProjectReference Include="..\Memux.Actions\Memux.Actions.csproj" />
    <ProjectReference Include="..\Memux.Perception\Memux.Perception.csproj" />
    <ProjectReference Include="..\Memux.Selection\Memux.Selection.csproj" />
    <ProjectReference Include="..\Memux.Composer\Memux.Composer.csproj" />
    <ProjectReference Include="..\Memux.Curriculum\Memux.Curriculum.csproj" />
    <ProjectReference Include="..\Memux.CodeGen\Memux.CodeGen.csproj" />
    <ProjectReference Include="..\Memux.UI\Memux.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy English tessdata to output directory -->
    <None Include="..\..\tessdata\eng.traineddata" Link="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tessdata\pdf.ttf" Link="tessdata\pdf.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

