{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Memux.App",
      "type": "coreclr",
      "request": "launch",
      "noDebug": true,
      "preLaunchTask": "Run Memux.App (Main)",
      "program": "dotnet",
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run Memux.App Unit Tests",
      "type": "coreclr",
      "request": "launch",
      "noDebug": true,
      "preLaunchTask": "Run Memux.App (Main)",
      "program": "dotnet",
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Profile Memux with Flame Graph",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Profile: Start and Attach to Memux",
      "program": "${workspaceFolder}/src/Memux.App/bin/Debug/net8.0-windows10.0.26100.0/Memux.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "noDebug": true,
      "internalConsoleOptions": "neverOpen"
    }
  ]
}



